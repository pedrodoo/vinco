---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE_URL, hreflangCode, ogLocale, siteName } from '../config/site';
import { sanitizeMetaDescription } from '../data/seo';
import { getLocalePaths, type Locale } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  ogImage: ImageMetadata;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, locale, ogImage, jsonLd } = Astro.props;

const metaDescription = sanitizeMetaDescription(description);
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const localePaths = getLocalePaths(Astro.url.pathname);
const ptUrl = new URL(localePaths.pt, Astro.site ?? SITE_URL).href;
const enUrl = new URL(localePaths.en, Astro.site ?? SITE_URL).href;
const xDefaultUrl = new URL('/', Astro.site ?? SITE_URL).href;
const currentOgLocale = ogLocale(locale);
const alternateOgLocale = locale === 'pt' ? ogLocale('en') : ogLocale('pt');
const brandName = siteName(locale);

const optimized = await getImage({
  src: ogImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});
const ogImageUrl = new URL(optimized.src, Astro.site ?? SITE_URL).href;
const ogImageAlt = locale === 'pt'
  ? 'Vinco Estúdio — Do conceito ao produto'
  : 'Vinco Studio — Concept to product';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={metaDescription} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={brandName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={currentOgLocale} />
<meta property="og:locale:alternate" content={alternateOgLocale} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImageUrl} />

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}

<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang={hreflangCode('pt')} href={ptUrl} />
<link rel="alternate" hreflang={hreflangCode('en')} href={enUrl} />
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
  rel="stylesheet"
/>
