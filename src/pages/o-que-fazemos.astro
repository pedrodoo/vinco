---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CategoryNav from '../components/work/CategoryNav.astro';
import CategorySection from '../components/work/CategorySection.astro';
import { useTranslations } from '../i18n/utils';
import { categories, getCategoryItems } from '../data/work';
import { getWhatWeDoPageSchemas } from '../data/schema';
import { getPageSeo } from '../data/seo';

const locale = 'pt';
const t = useTranslations(locale);
const seo = getPageSeo(locale, 'whatWeDo');
---

<Base
  title={seo.title}
  description={seo.description}
  locale={locale}
  jsonLd={getWhatWeDoPageSchemas(locale)}
>
  <PageHero
    title={t.home.categories_title}
    intro={t.work.categories_intro}
  />

  <section class="bg-vinco-black px-8 py-24">
    <div class="max-w-[1440px] mx-auto">
      <CategoryNav categories={categories} locale={locale} />

      <div>
        {
          categories.map((cat) => (
            <CategorySection
              slug={cat.slug}
              label={cat.label[locale]}
              items={getCategoryItems(cat.slug)}
              locale={locale}
            />
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  function scrollToHash() {
    const hash = window.location.hash.slice(1);
    if (!hash) return;

    const target = document.getElementById(hash);
    if (!target) return;

    requestAnimationFrame(() => {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  scrollToHash();
  window.addEventListener('hashchange', scrollToHash);
</script>
