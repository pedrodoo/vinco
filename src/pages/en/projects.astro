---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/work/ProjectCard.astro';
import { useTranslations } from '../../i18n/utils';
import {
  getCaseStudies,
  getCaseStudyCopyKey,
  getProjectPath,
} from '../../data/work';
import { getProjectsPageSchemas } from '../../data/schema';
import { getPageSeo } from '../../data/seo';

const locale = 'en';
const t = useTranslations(locale);
const seo = getPageSeo(locale, 'work');
const caseStudies = getCaseStudies();
const caseCopyByKey = t.work.cases;
const projectItems = caseStudies.map((project) => {
  const copyKey = getCaseStudyCopyKey(project.slug);
  const caseCopy = copyKey ? caseCopyByKey[copyKey as keyof typeof caseCopyByKey] : undefined;

  return {
    name: caseCopy?.title ?? project.client,
    path: getProjectPath(project.slug, locale),
  };
});
const legacyHashRedirects = Object.fromEntries(
  caseStudies.map((project) => [project.slug, getProjectPath(project.slug, locale)]),
);
---

<Base
  title={seo.title}
  description={seo.description}
  locale={locale}
  jsonLd={getProjectsPageSchemas(locale, projectItems)}
>
  <PageHero title={t.home.work_title} intro={t.work.intro} />

  <section class="bg-vinco-cream border-t border-vinco-brown-1/20 px-8 py-24">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          caseStudies.map((project, index) => (
            <ProjectCard project={project} locale={locale} staggerIndex={index} />
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ legacyHashRedirects }}>
  const hash = window.location.hash.replace(/^#/, '');
  const target = legacyHashRedirects[hash];
  if (target) {
    window.location.replace(target);
  }
</script>
