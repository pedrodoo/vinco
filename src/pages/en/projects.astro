---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CaseStudySection from '../../components/work/CaseStudySection.astro';
import { useTranslations } from '../../i18n/utils';
import { getCaseStudies, getCaseStudyCopyKey, getCaseStudyGallery, formatProjectPeriod } from '../../data/work';
import { getProjectsPageSchemas } from '../../data/schema';
import { getPageSeo } from '../../data/seo';

const locale = 'en';
const t = useTranslations(locale);
const seo = getPageSeo(locale, 'work');
const caseStudies = getCaseStudies();
const caseCopyByKey = t.work.cases;
const projectNames = caseStudies.map((project) => {
  const copyKey = getCaseStudyCopyKey(project.slug);
  const caseCopy = copyKey ? caseCopyByKey[copyKey as keyof typeof caseCopyByKey] : undefined;
  return caseCopy?.title ?? project.client;
});
---

<Base
  title={seo.title}
  description={seo.description}
  locale={locale}
  jsonLd={getProjectsPageSchemas(locale, projectNames)}
>
  <PageHero title={t.home.work_title} intro={t.work.intro} />

  <section class="bg-vinco-cream border-t border-vinco-brown-1/20 px-8 py-24">
    <div class="max-w-[1440px] mx-auto">
      <div>
        {
          caseStudies.map((project) => {
            const copyKey = getCaseStudyCopyKey(project.slug);
            const caseCopy = copyKey
              ? caseCopyByKey[copyKey as keyof typeof caseCopyByKey]
              : undefined;

            return (
              <CaseStudySection
                id={project.slug}
                title={caseCopy?.title ?? project.client}
                tags={project.tags.map((t) => t[locale])}
                period={formatProjectPeriod(project.period, locale)}
                description={caseCopy?.description ?? ''}
                gallery={getCaseStudyGallery(project)}
                imageAlt={caseCopy?.title ?? project.client}
              />
            );
          })
        }
      </div>
    </div>
  </section>
</Base>
